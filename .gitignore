# Port-scoped since S17 — the unsuffixed names above are the legacy files the
# default-port instance migrates once, so both shapes must stay ignored.
web/.cockpit-*.pid
web/.cockpit-child-pids-*

# Reaper hygiene-tool incremental review cache
.reaper/

# Local build/release artifact downloads (not project-relative Downloads folder)
downloads/

# Internal working documents — kept ON DISK, deliberately not published.
# These are planning notes, agent instructions, QA scratch and architecture
# rationale written for whoever is building, not for whoever is using. They
# name working paths, unshipped plans and half-formed opinions. Untracked with
# `git rm --cached` rather than deleted: they are still the project's memory.
CLAUDE.md
AGENTS.md
BACKLOG.md
CONTINUATION.md
QA_PLAN.md
RALPH.md
backlog/
docs/
